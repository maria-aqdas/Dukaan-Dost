# Copy these into Vercel > Project > Settings > Environment Variables.
# Never commit real keys.
AMD_BASE_URL=   # OpenAI-compatible base URL shown on notebooks.amd.com/tokenfactory (the part before /chat/completions)
AMD_API_KEY=    # your Token Factory API key
AMD_MODEL=      # a model name exactly as Token Factory lists it (a Gemma model qualifies you for the Google prize)
  
                        
